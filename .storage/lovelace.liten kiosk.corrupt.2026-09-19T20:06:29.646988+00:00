{
  "version": 1,
  "minor_version": 1,
  "key": "lovelace.liten kiosk",
  "data": {
    "config": {
      "views": [
        {
          "type": "sections",
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading_style": "title"
                },
                {
                  "type": "custom:apexcharts-card",
                  "show": {
                    "last_updated": true
                  },
                  "header": {
                    "show": false,
                    "show_states": false,
                    "colorize_states": true
                  },
                  "now": {
                    "show": false,
                    "color": "black"
                  },
                  "all_series_config": {
                    "type": "area",
                    "stroke_width": 1,
                    "curve": "smooth",
                    "opacity": 0.09,
                    "show": {
                      "legend_value": false,
                      "extremas": true
                    }
                  },
                  "grid_options": {
                    "columns": 6,
                    "header": null,
                    "show": true,
                    "title": "Nord Pool SE2 – Future prices"
                  },
                  "graph_span": "48h",
                  "span": {
                    "start": "day"
                  },
                  "series": [
                    {
                      "entity": "sensor.nord_pool_se2_tomorrow",
                      "name": "Today",
                      "color": "magenta",
                      "extend_to": false,
                      "data_generator": "const now = Date.now();\nreturn entity.attributes.today_prices\n  .map(p => [\n    new Date(p.start).getTime(),\n    p.price / 1000\n  ]);\n"
                    },
                    {
                      "entity": "sensor.nord_pool_se2_tomorrow",
                      "name": "Tomorrow",
                      "color": "orange",
                      "data_generator": "const now = Date.now();\nreturn entity.attributes.prices \n  .map(p => [\n    new Date(p.start).getTime(),\n    p.price / 1000\n  ]);\n"
                    }
                  ],
                  "apex_config": {
                    "xaxis": {
                      "type": "datetime",
                      "tickAmount": 8,
                      "labels": {
                        "datetimeUTC": false,
                        "formatter": "EVAL:function(value, timestamp) {\n  const d = new Date(timestamp);\n  return d.toLocaleTimeString([], {\n    hour: '2-digit',\n  \n    hour12: false\n  });\n}\n"
                      }
                    },
                    "grid": {
                      "xaxis": {
                        "lines": {
                          "show": true
                        }
                      }
                    },
                    "annotations": {
                      "xaxis": [
                        {
                          "x": "EVAL:Date.now()",
                          "borderColor": "blue",
                          "strokeDashArray": 0,
                          "borderWidth": 2
                        }
                      ]
                    }
                  }
                },
                {
                  "type": "clock",
                  "clock_style": "analog",
                  "clock_size": "medium",
                  "show_seconds": false,
                  "no_background": false,
                  "border": true,
                  "ticks": "hour",
                  "date_format": [
                    "year-numeric",
                    "separator-dash",
                    "month-2-digit",
                    "separator-dash",
                    "day-2-digit"
                  ],
                  "grid_options": {
                    "rows": "auto"
                  },
                  "face_style": "markers"
                },
                {
                  "show_name": false,
                  "show_icon": true,
                  "show_state": false,
                  "color": "state",
                  "type": "glance",
                  "entities": [
                    {
                      "entity": "switch.pump",
                      "show_last_changed": false,
                      "icon": "mdi:water-pump",
                      "hold_action": {
                        "action": "toggle"
                      }
                    },
                    {
                      "entity": "cover.ute_vattenkran",
                      "name": {
                        "type": "device"
                      },
                      "show_state": true,
                      "hold_action": {
                        "action": "toggle"
                      }
                    },
                    {
                      "entity": "switch.tegel_kok_tak_2",
                      "show_state": true,
                      "icon": "",
                      "show_last_changed": false,
                      "hold_action": {
                        "action": "toggle"
                      },
                      "name": "Tak",
                      "color": "state"
                    },
                    {
                      "entity": "light.vinterhagenel",
                      "hold_action": {
                        "action": "toggle"
                      },
                      "icon": "mdi:fence-electric"
                    }
                  ],
                  "grid_options": {
                    "columns": "full"
                  }
                },
                {
                  "type": "statistics-graph",
                  "grid_options": {
                    "columns": 6,
                    "rows": 3
                  },
                  "entities": [
                    {
                      "entity": "sensor.p1ib_active_power_plus_q1_q4",
                      "name": "Köpt från nätet",
                      "color": "red"
                    },
                    {
                      "entity": "sensor.p1ib_active_power_minus_q2_q3",
                      "name": "Sålt till nätet",
                      "color": "green"
                    }
                  ],
                  "days_to_show": 20,
                  "period": "day",
                  "chart_type": "line",
                  "stat_types": [
                    "mean",
                    "min"
                  ],
                  "hide_legend": true,
                  "expand_legend": true,
                  "logarithmic_scale": false,
                  "energy_date_selection": false
                },
                {
                  "type": "custom:mushroom-media-player-card",
                  "entity": "media_player.living_room_living_room",
                  "use_media_info": false,
                  "show_volume_level": true,
                  "volume_controls": [
                    "volume_set"
                  ],
                  "media_controls": [
                    "play_pause_stop",
                    "next",
                    "previous"
                  ],
                  "collapsible_controls": true,
                  "visibility": [
                    {
                      "condition": "state",
                      "state_not": "idle"
                    }
                  ]
                },
                {
                  "type": "tile",
                  "entity": "sensor.nord_pool_se2_current_price"
                },
                {
                  "type": "heading",
                  "heading": "AVSTÄNGDA  (normalt på)",
                  "heading_style": "title"
                },
                {
                  "type": "custom:auto-entities",
                  "filter": {
                    "include": [
                      {
                        "options": {},
                        "label": "warn_when_off",
                        "state": "/^(off|closed)$/"
                      }
                    ]
                  },
                  "card": {
                    "type": "entities"
                  },
                  "grid_options": {
                    "columns": 9,
                    "rows": "auto"
                  }
                },
                {
                  "type": "heading",
                  "heading": "PÅ (normalt avstängda)",
                  "heading_style": "title"
                },
                {
                  "type": "custom:auto-entities",
                  "filter": {
                    "include": [
                      {
                        "options": {},
                        "label": "warn_if_on",
                        "state": "/^(on|open|opening|closing)$/"
                      }
                    ]
                  },
                  "card": {
                    "type": "entities",
                    "card_mod": {
                      "style": {
                        "hui-generic-entity-row": {
                          "$": {
                            "state-badge": {
                              "$": "ha-icon { color: yellow !important; }"
                            }
                          }
                        }
                      }
                    }
                  }
                },


              ],
              "column_span": 1
            }
          ]
        }
      ]
    }
  }
}